{
  "opencollection": "1.0.0",
  "info": {
    "name": "DoControl Authentication GraphQL API",
    "version": "4.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "GraphQL",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Execute a GraphQL query or mutation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://apollo-gateway-v4-api.prod.docontrol.io/graphql",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Single GraphQL endpoint. Provide a query or mutation in the request body. Requires admin permission and a Bearer access token."
        }
      ]
    }
  ],
  "bundled": true
}